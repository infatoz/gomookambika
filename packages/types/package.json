{
  "name": "@gomookambika/types",
  "version": "1.0.0",
  "private": true,
  "description": "Shared TypeScript types for Go Mookambika",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
