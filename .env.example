# ==========================================
# GO MOOKAMBIKA — ENVIRONMENT VARIABLES
# ==========================================
# Copy this file to .env and fill in values
# NEVER commit .env to version control

# ==========================================
# APPLICATION
# ==========================================
NODE_ENV=development
PORT=5000
API_VERSION=v1
FRONTEND_URLS=http://localhost:3000,http://localhost:3001,http://localhost:3002

# ==========================================
# DATABASE
# ==========================================
MONGODB_URI=mongodb://localhost:27017/gomookambika
MONGODB_DB_NAME=gomookambika

# ==========================================
# REDIS
# ==========================================
REDIS_URL=redis://localhost:6379
REDIS_PREFIX=gm:

# ==========================================
# JWT
# ==========================================
JWT_SECRET=your-super-secret-jwt-key-minimum-32-characters
JWT_REFRESH_SECRET=your-super-secret-refresh-jwt-key-minimum-32-characters
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ==========================================
# OTP
# ==========================================
OTP_PROVIDER=console
# Options: console | twilio | msg91 | fast2sms
OTP_API_KEY=
OTP_SENDER_ID=GOMOOK
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60

# Development OTP (NEVER enable in production)
DEV_OTP_ENABLED=true
DEV_OTP=123456

# ==========================================
# PAYMENT
# ==========================================
PAYMENT_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ==========================================
# MAPS & GEOCODING
# ==========================================
MAP_PROVIDER=osm
GEOCODING_PROVIDER=nominatim
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
GEOCODING_USER_AGENT=GoMookambika/1.0 (contact@gomookambika.com)

ROUTING_PROVIDER=osrm
ROUTING_BASE_URL=https://router.project-osrm.org

# ==========================================
# NOTIFICATIONS — FCM
# ==========================================
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# ==========================================
# NOTIFICATIONS — EMAIL
# ==========================================
EMAIL_PROVIDER=console
# Options: console | smtp | sendgrid | ses
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@gomookambika.com
SENDGRID_API_KEY=

# ==========================================
# FILE STORAGE
# ==========================================
STORAGE_PROVIDER=local
# Options: local | s3 | cloudinary
STORAGE_LOCAL_PATH=./uploads
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
AWS_S3_BUCKET=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ==========================================
# QUEUE CONFIGURATION
# ==========================================
QUEUE_QR_EXPIRY_SECONDS=0
# 0 = static QR (no expiry), >0 = dynamic QR
QUEUE_RADIUS_METERS=100
QUEUE_HEARTBEAT_SECONDS=30
QUEUE_GRACE_PERIOD_SECONDS=120
QUEUE_MAX_MISSED_HEARTBEATS=3
QUEUE_DEFAULT_POLICY=FIFO
# Options: FIFO | VEHICLE_CATEGORY_FIFO | NEAREST_ELIGIBLE | MANUAL_ASSIGNMENT

# ==========================================
# DISPATCH CONFIGURATION
# ==========================================
DRIVER_TRIP_ACCEPT_TIMEOUT_SECONDS=30
DRIVER_MAX_DECLINE_COUNT=3
DRIVER_DECLINE_POLICY=MOVE_TO_END
# Options: KEEP_POSITION | MOVE_TO_END | TEMPORARY_PAUSE | SUSPEND_AFTER_REPEATED_DECLINE
DRIVER_PAUSE_DURATION_MINUTES=30

# ==========================================
# BOOKING
# ==========================================
BOOKING_ID_PREFIX=GM
TRIP_ID_PREFIX=TRIP
PAYMENT_ID_PREFIX=PAY-GM

# ==========================================
# SECURITY
# ==========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
OTP_RATE_LIMIT_WINDOW_MS=3600000
OTP_RATE_LIMIT_MAX_REQUESTS=5
BCRYPT_ROUNDS=12

# ==========================================
# LOGGING
# ==========================================
LOG_LEVEL=debug
# Options: error | warn | info | http | debug
LOG_FILE_ENABLED=false
LOG_FILE_PATH=./logs

# ==========================================
# SWAGGER
# ==========================================
SWAGGER_ENABLED=true
# Set to false in production or restrict access
